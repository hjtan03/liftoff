      "id": "wavelength-in-a-microwave-oven",
      "category": "Everyday",
      "prompt": "A microwave oven runs at 2.45 GHz. How many millimeters long is one of its waves?",
      "unit": "mm",
      "rounding": "round",
      "roundingNote": "Rounded to the nearest millimeter.",
      "factors": [
        {
          "key": "c",
          "label": "Speed of light",
          "unit": "m/s",
          "value": 299792458,
          "source": "SI definition of the meter"
        },
        {
          "key": "f",
          "label": "Oven frequency",
          "unit": "GHz",
          "value": 2.45,
          "source": "Given in the question"
        }
      ],
      "formula": "c / (f * 1000000000) * 1000"
    },
