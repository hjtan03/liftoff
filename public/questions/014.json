  "questions": [
    {
      "id": "letter-sheets-to-cover-an-acre",
      "category": "Everyday",
      "prompt": "How many US Letter sheets would it take to cover an acre?",
      "unit": "sheets",
      "rounding": "ceil",
      "roundingNote": "Partial sheet counts as a whole sheet (round up).",
      "factors": [
        {
          "key": "l",
          "label": "Long edge of a Letter sheet",
          "unit": "in",
          "value": 11,
          "source": "ANSI Letter, 8.5 × 11 in"
        },
        {
          "key": "s",
          "label": "Short edge of a Letter sheet",
          "unit": "in",
          "value": 8.5,
          "source": "ANSI Letter, 8.5 × 11 in"
        },
        {
          "key": "ac",
          "label": "Acre",
          "unit": "ft²",
          "value": 43560,
          "source": "International acre"
        }
      ],
      "formula": "ac * 144 / (l * s)"
    },
    {
      "id": "blinks-in-a-year",
      "category": "Body",
      "prompt": "Blinking 15 times a minute for 16 waking hours a day, how many times do you blink in a common year?",
      "unit": "blinks",
      "rounding": "round",
      "roundingNote": "Rounded to the nearest blink.",
      "factors": [
        {
          "key": "d",
          "label": "Days in a common year",
          "unit": "days",
          "value": 365,
          "source": "Gregorian calendar"
        }
      ],
      "formula": "15 * 60 * 16 * d"
    },
