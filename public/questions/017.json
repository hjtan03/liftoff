    {
      "id": "bulb-left-on-for-a-year",
      "category": "Everyday",
      "prompt": "A 60 W bulb is left on for a whole common year. How many kilowatt-hours does it use?",
      "unit": "kWh",
      "rounding": "round",
      "roundingNote": "Rounded to the nearest kWh.",
      "factors": [
        {
          "key": "d",
          "label": "Days in a common year",
          "unit": "days",
          "value": 365,
          "source": "Gregorian calendar"
        }
      ],
      "formula": "60 * 24 * d / 1000"
    },
    {
      "id": "frequency-of-middle-c",
      "category": "Music",
      "prompt": "Tuned to concert pitch, how many hertz is middle C, nine semitones below concert A?",
      "unit": "Hz",
      "rounding": "round",
      "roundingNote": "Rounded to the nearest hertz.",
      "factors": [
        {
          "key": "a",
          "label": "Concert pitch A",
          "unit": "Hz",
          "value": 440,
          "source": "ISO 16"
        }
      ],
      "formula": "a / 2 ^ (9 / 12)"
    },
    {
