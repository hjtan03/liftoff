      "rounding": "round",
      "roundingNote": "Rounded to the nearest hour.",
      "factors": [
        {
          "key": "l",
          "label": "Pool length",
          "unit": "m",
          "value": 50,
          "source": "World Aquatics"
        },
        {
          "key": "w",
          "label": "Pool width",
          "unit": "m",
          "value": 25,
          "source": "World Aquatics"
        },
        {
          "key": "flow",
          "label": "Hose flow",
          "unit": "L/min",
          "value": 40,
          "source": "Given in the question"
        }
      ],
      "formula": "l * w * 2 * 1000 / flow / 60"
    },
