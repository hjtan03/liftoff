      "id": "aa-batteries-along-a-marathon",
      "category": "Everyday",
      "prompt": "How many AA batteries, placed end to end, span a marathon course?",
      "unit": "batteries",
      "rounding": "ceil",
      "roundingNote": "Enough to cover the whole course (round up).",
      "factors": [
        {
          "key": "mm",
          "label": "AA battery length",
          "unit": "mm",
          "value": 50.5,
          "source": "IEC 60086, size R6"
        },
        {
          "key": "d",
          "label": "Marathon distance",
          "unit": "km",
          "value": 42.195,
          "source": "World Athletics standard"
        }
      ],
      "formula": "d * 1000000 / mm"
    },
    {
