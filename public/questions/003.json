      "id": "volume-of-a-shipping-container",
      "category": "Everyday",
      "prompt": "Measured on the outside, how many cubic meters does a standard 20 ft shipping container enclose?",
      "unit": "m³",
      "rounding": "round",
      "roundingNote": "Rounded to the nearest cubic meter.",
      "factors": [
        {
          "key": "l",
          "label": "Shipping container length",
          "unit": "ft",
          "value": 20,
          "source": "ISO 668, 20 ft container"
        },
        {
          "key": "w",
          "label": "Shipping container width",
          "unit": "ft",
          "value": 8,
          "source": "ISO 668"
        },
        {
          "key": "h",
          "label": "Shipping container height",
          "unit": "ft",
          "value": 8.5,
          "source": "ISO 668, 8 ft 6 in"
        }
      ],
      "formula": "l * w * h * 304.8 ^ 3 / 1000000000"
    },
